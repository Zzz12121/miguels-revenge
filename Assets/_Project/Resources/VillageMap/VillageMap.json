            "x1": 70.02000427246094,
            "z1": -11.0
        },
        {
            "id": "town",
            "name": "市街",
            "desc": "三排房子和中間的主街。茶屋（甜點、長椅）、鐵匠鋪（換武器、用虎皮虎牙升級）、藥鋪（草藥換藥水）都在這裡，北邊那排主街西側是你暫住的老房子。",
            "image": "Map_town",
            "x0": -103.51805114746094,
            "z0": -53.103118896484375,
            "x1": 97.60693359375,
            "z1": 72.5999984741211
        },
        {
            "id": "chief",
            "name": "村長宅院",
            "desc": "村子東邊盡頭、全村最大的宅院。村長住在主殿裡；後院東牆的大門通往道場。",
