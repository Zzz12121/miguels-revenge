  gate: {fileID: 0}
  talksNeeded: 3
  secretLines:
  - "\u53C8\u662F\u4F60\u2026\u2026\u9019\u5DF2\u7D93\u662F\u7B2C\u4E09\u6B21\u4E86\u3002\u770B\u4F86\u4F60\u662F\u771F\u7684\u60F3\u77E5\u9053\u7384\u6E05\u9053\u4EBA\u7684\u4E0B\u843D\u3002"
  - "@\u6211\u60F3\u77E5\u9053\u771F\u76F8\u3002"
  - "\u8DDF\u4F60\u8AAA\u500B\u79D8\u5BC6\uFF1A\u6751\u9577\u5BB6\u5F8C\u9662\u90A3\u6247\u8001\u9580\uFF0C\u958B\u9580\u7684\u6CD5\u5B50\u5C31\u5BEB\u5728\u4E00\u672C\u820A\u66F8\u7684\u593E\u9801\u88E1\uFF0C\u6211\u6284\u66F8\u7684\u6642\u5019\u767C\u73FE\u7684\u3002"
  - "\u6211\u5DF2\u7D93\u5077\u5077\u628A\u9580\u6253\u958B\u4E86\u3002\u4F60\u73FE\u5728\u53BB\u6751\u9577\u5BB6\u5F8C\u9662\uFF0C\u76F4\u63A5\u8D70\u904E\u53BB\u5C31\u884C\u3002"
  - "\u8A18\u4F4F\uFF0C\u9019\u662F\u6211\u5011\u4E4B\u9593\u7684\u79D8\u5BC6\u3002\u5343\u842C\u5225\u8B93\u6751\u9577\u77E5\u9053\u662F\u6211\u505A\u7684\u3002"
  - "@\u653E\u5FC3\uFF0C\u6211\u4E0D\u6703\u8AAA\u51FA\u53BB\u7684\u3002"
  alreadyOpenLines:
  - "\u6751\u9577\u5BB6\u5F8C\u9662\u90A3\u6247\u9580\u2026\u2026\u770B\u4F86\u4F60\u5DF2\u7D93\u6709\u8FA6\u6CD5\u904E\u53BB\u4E86\u3002\u90A3\u6211\u7684\u79D8\u5BC6\u5C31\u6D3E\u4E0D\u4E0A\u7528\u5834\u5566\u3002"
