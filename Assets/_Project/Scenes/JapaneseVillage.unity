  guideLines:
  - "\u554A\u2026\u2026\u62B1\u6B49\uFF0C\u770B\u5F97\u592A\u5165\u795E\u4E86\u3002\u6211\u662F\u5F9E\u4EAC\u57CE\u4F86\u7684\u66F8\u751F\uFF0C\u5230\u5404\u5730\u6284\u9304\u53E4\u8001\u7684\u50B3\u8AAA\u3002"
  - "@\u53E4\u8001\u7684\u50B3\u8AAA\uFF1F\u9019\u500B\u6751\u5B50\u4E5F\u6709\u55CE\uFF1F"
  - "\u7384\u6E05\u9053\u4EBA\u5728\u6D77\u4E0A\u65AC\u9F8D\u7684\u6545\u4E8B\uFF0C\u4EAC\u57CE\u7684\u8AAA\u66F8\u4EBA\u4E5F\u8B1B\u904E\u3002\u53EF\u662F\u4ED6\u5F8C\u4F86\u600E\u9EBC\u4E86\uFF0C\u66F8\u4E0A\u4E00\u500B\u5B57\u90FD\u6C92\u5BEB\u3002"
  - "@\u4ED6\u5F8C\u4F86\u600E\u9EBC\u4E86\uFF1F"
  - "\u807D\u8AAA\u9053\u4EBA\u7559\u4E0B\u7684\u56DB\u5E45\u53E4\u756B\u548C\u4E00\u9996\u8A69\uFF0C\u5C31\u6536\u5728\u5C71\u9802\u7684\u7960\u5802\u88E1\u3002\u4F60\u8981\u4E0A\u53BB\u7684\u8A71\uFF0C\u5E6B\u6211\u7559\u610F\u8A69\u88E1\u5BEB\u4E86\u4EC0\u9EBC\u3002"
  - "\u90A3\u9996\u8A69\u7684\u6700\u5F8C\u5E7E\u53E5\u6211\u53EA\u807D\u4EBA\u5538\u904E\uFF1A\u300C\u8AB0\u958B\u9577\u8005\u5F8C\u5712\u9580\u300D\u2026\u2026\u6751\u88E1\u7684\u9577\u8005\uFF0C\u8AAA\u7684\u6703\u4E0D\u6703\u5C31\u662F\u6751\u9577\uFF1F"
  - "@\u6211\u53BB\u554F\u554F\u770B\u3002"
  repeatLines:
  - "\u66F8\u4E0A\u5BEB\u7684\uFF0C\u548C\u6751\u88E1\u4EBA\u8AAA\u7684\uFF0C\u7E3D\u6709\u4E9B\u4E0D\u4E00\u6A23\u3002"
