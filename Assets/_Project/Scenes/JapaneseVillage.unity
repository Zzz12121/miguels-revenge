  options:
  - "\u5F9E\u6D77\u7684\u90A3\u4E00\u908A\u6F02\u904E\u4F86\u7684"
  - "\u7FFB\u904E\u5317\u908A\u7684\u5C71\u4F86\u7684"
  - "\u2026\u2026\u6211\u4E0D\u8A18\u5F97\u4E86"
  replies:
  - "\u6D77\u7684\u90A3\u4E00\u908A\uFF1F\u6700\u8FD1\u5916\u6D77\u4E0D\u592A\u5E73\u975C\uFF0C\u4F60\u80FD\u5E73\u5B89\u4E0A\u5CB8\uFF0C\u547D\u53EF\u771F\u5927\u3002|\u6751\u88E1\u7684\u4EBA\u5C0D\u6D77\u4E0A\u4F86\u7684\u5BA2\u4EBA\u90FD\u5F88\u597D\u5947\uFF0C\u6709\u7A7A\u5C31\u56DB\u8655\u8D70\u8D70\uFF0C\u807D\u807D\u4ED6\u5011\u600E\u9EBC\u8AAA\u3002|\u5C0D\u4E86\uFF0C\u60F3\u7528\u8349\u85E5\u63DB\u85E5\u6C34\u7684\u8A71\uFF0C\u53BB\u627E\u85E5\u5E2B\u3002\u4ED6\u7684\u85E5\u92EA\u5C31\u5728\u6211\u6524\u5B50\u6771\u5317\u908A\u90A3\u6392\u623F\u5B50\uFF0C\u9580\u53E3\u64FA\u8457\u85E5\u7F3D\u3001\u5728\u714E\u85E5\u7684\u90A3\u9593\u3002"
  - "\u7FFB\u5C71\u4F86\u7684\uFF1F\u90A3\u4F60\u4E00\u5B9A\u7A7F\u904E\u5F8C\u5C71\u7684\u7AF9\u6797\u4E86\u2014\u2014\u807D\u8AAA\u7AF9\u6797\u6DF1\u8655\u4F4F\u8457\u4E00\u982D\u96D9\u5C3E\u7684\u8001\u864E\uFF0C\u4E0B\u6B21\u53EF\u5225\u4E00\u500B\u4EBA\u4E82\u95D6\u3002|\u5C71\u9802\u7684\u7960\u5802\u4F9B\u5949\u8457\u7384\u6E05\u9053\u4EBA\uFF0C\u4E0A\u53BB\u62DC\u4E00\u62DC\uFF0C\u8AAA\u4E0D\u5B9A\u80FD\u4FDD\u4F51\u4F60\u4E00\u8DEF\u5E73\u5B89\u3002|\u5C0D\u4E86\uFF0C\u60F3\u7528\u8349\u85E5\u63DB\u85E5\u6C34\u7684\u8A71\uFF0C\u53BB\u627E\u85E5\u5E2B\u3002\u4ED6\u7684\u85E5\u92EA\u5C31\u5728\u6211\u6524\u5B50\u6771\u5317\u908A\u90A3\u6392\u623F\u5B50\uFF0C\u9580\u53E3\u64FA\u8457\u85E5\u7F3D\u3001\u5728\u714E\u85E5\u7684\u90A3\u9593\u3002"
  - "\u4E0D\u8A18\u5F97\u4E86\uFF1F\u2026\u2026\u4E5F\u7F77\uFF0C\u770B\u4F60\u9019\u8EAB\u6253\u626E\u5C31\u4E0D\u662F\u672C\u5730\u4EBA\u3002\u4F86\u8655\u4E0D\u91CD\u8981\uFF0C\u8981\u5F80\u54EA\u88E1\u53BB\u624D\u91CD\u8981\u3002|\u6751\u9577\u7684\u5B85\u9662\u5728\u6771\u908A\u76E1\u982D\uFF0C\u4ED6\u898B\u591A\u8B58\u5EE3\uFF0C\u6216\u8A31\u77E5\u9053\u4E9B\u4EC0\u9EBC\u3002|\u5C0D\u4E86\uFF0C\u60F3\u7528\u8349\u85E5\u63DB\u85E5\u6C34\u7684\u8A71\uFF0C\u53BB\u627E\u85E5\u5E2B\u3002\u4ED6\u7684\u85E5\u92EA\u5C31\u5728\u6211\u6524\u5B50\u6771\u5317\u908A\u90A3\u6392\u623F\u5B50\uFF0C\u9580\u53E3\u64FA\u8457\u85E5\u7F3D\u3001\u5728\u714E\u85E5\u7684\u90A3\u9593\u3002"
  repeatAfter:
  - "\u6D77\u4E0A\u4F86\u7684\u65C5\u4EBA\uFF0C\u53C8\u898B\u9762\u4E86\u3002\u6751\u88E1\u901B\u5F97\u9084\u7FD2\u6163\u55CE\uFF1F|\u8349\u85E5\u8A18\u5F97\u62FF\u53BB\u7D66\u85E5\u5E2B\uFF0C\u4ED6\u7684\u85E5\u92EA\u5728\u6211\u6524\u5B50\u6771\u5317\u908A\u3002"
  - "\u7FFB\u5C71\u4F86\u7684\u65C5\u4EBA\uFF01\u7AF9\u6797\u88E1\u90A3\u982D\u8001\u864E\uFF0C\u4F60\u9047\u5230\u4E86\u55CE\uFF1F|\u8349\u85E5\u8A18\u5F97\u62FF\u53BB\u7D66\u85E5\u5E2B\uFF0C\u4ED6\u7684\u85E5\u92EA\u5728\u6211\u6524\u5B50\u6771\u5317\u908A\u3002"
  - "\u60F3\u8D77\u81EA\u5DF1\u5F9E\u54EA\u88E1\u4F86\u4E86\u55CE\uFF1F\u2026\u2026\u4E0D\u6025\uFF0C\u6162\u6162\u4F86\u3002|\u8349\u85E5\u8A18\u5F97\u62FF\u53BB\u7D66\u85E5\u5E2B\uFF0C\u4ED6\u7684\u85E5\u92EA\u5728\u6211\u6524\u5B50\u6771\u5317\u908A\u3002"
